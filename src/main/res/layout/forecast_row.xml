<?xml version="1.0" encoding="utf-8"?>
<!-- One pay period: date badge, the paycheck and bills it covers, and what's left in the bank.
     Tapping it opens the details (each bill with its date) underneath. -->
<!-- Overdraw: this row is added inside a card in code, not used as an activity root, and its background is
     the pressed-state ripple, which is transparent until the row is touched, so nothing is painted twice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Grows with large text instead of cutting "TODAY" off -->
        <LinearLayout
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/chip_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:textColor="@color/chip_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/chip_text"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- The text and what's left in the bank, which with large text goes on its own line under the text
             (still at the end) so "+$1,234.56" isn't squeezed beside it and split mid-number. Takes the rest
             of the row: the last match_parent child of a horizontal LinearLayout gets exactly the width left
             (a weight here would nest weights). baselineAligned="false" changes nothing visually: neither
             child reports a baseline (a vertical LinearLayout and a FrameLayout), so nothing was ever aligned. -->
        <LinearLayout
            android:id="@+id/forecast_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:tag="stack_when_large_text">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Paycheck and "usually $750"; with large text the pill goes under the paycheck instead of
                     being squeezed into a tall, narrow pill beside it. -->
                <LinearLayout
                    android:id="@+id/forecast_title_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:tag="stack_when_large_text">

                    <TextView
                        android:id="@+id/forecast_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <!-- "usually $750" when this paycheck isn't the usual amount. The frame holds the gap (and
                         spans the row when stacked) so the pill itself stays the size of its text. -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:id="@+id/forecast_changed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/chip_text"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/forecast_bills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- "Short $30" when this payday can't cover its bills -->
                <TextView
                    android:id="@+id/forecast_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/negative"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The frame spans the row when stacked, keeping the amount at the end like the other rows' -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/forecast_left"
                    style="@style/Money"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textSize="16sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Details: each bill in this pay period, plus an action -->
    <LinearLayout
        android:id="@+id/forecast_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingEnd="0dp"
        android:visibility="gone" />
</LinearLayout>
