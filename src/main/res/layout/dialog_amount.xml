<?xml version="1.0" encoding="utf-8"?>
<!-- The "$" box used in amount dialogs (bank balance, a paycheck). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <LinearLayout style="@style/MoneyBox">

        <TextView style="@style/DollarSign" />

        <!-- LabelFor: this box goes inside an AlertDialog whose title and message (set in code) say what
             the amount is for, and it already shows the "0.00" hint from @style/MoneyInput (lint doesn't
             read hints from styles). inputType is replaced in code (adds a sign flag for some dialogs). -->
        <EditText
            android:id="@+id/dialog_amount_input"
            style="@style/MoneyInput"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            tools:ignore="LabelFor" />
    </LinearLayout>
</FrameLayout>
