<?xml version="1.0" encoding="utf-8"?>
<!-- How the widget looks in the home screen's widget picker (Android 12+): widget_budget.xml with example numbers.
     Keep the two alike. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingVertical="18dp">

    <!-- Safe to spend, and the button. UseCompoundDrawables: the button has its own tap, so it can't be a drawable
         on the text. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="smcp"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="Safe to spend this week"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="$760.14"
                android:textColor="@color/widget_text"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/widget_note"
                android:text="Payday tomorrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Update the balance (or the bank's status and Sync now, when linked) -->
        <ImageView
            android:id="@+id/widget_action"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button"
            android:contentDescription="Update bank balance"
            android:padding="17dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/widget_icon" />
    </LinearLayout>

    <!-- How much of this week's money is spent (only when the widget is tall enough). Tall enough for the knob;
         the line itself is 3dp. -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="16dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="420"
        android:progressDrawable="@drawable/widget_progress" />

    <!-- Under the line, like a player's elapsed and total time: spent so far, and this week's money. -->
    <LinearLayout
        android:id="@+id/widget_spent_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_spent"
            android:text="Spent $412"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_week"
            android:text="of $980"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_bank_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="smcp"
                android:letterSpacing="0.04"
                android:text="Bank"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_bank"
                android:text="$4,927.00"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_bill_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="smcp"
                android:letterSpacing="0.04"
                android:text="Next bill"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_bill"
                android:text="Phone $65 · Sat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
