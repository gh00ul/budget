<?xml version="1.0" encoding="utf-8"?>
<!-- One bill. Swiping right shows a green "Paid" layer, swiping left a red "Delete" layer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/bill_row_paid_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/paid_bg"
        android:gravity="center_vertical|start"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:visibility="invisible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            android:tint="@color/positive" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Paid"
            android:textColor="@color/positive"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bill_row_delete_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/delete_bg"
        android:gravity="center_vertical|end"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingEnd="20dp"
        android:visibility="invisible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/negative" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Delete"
            android:textColor="@color/negative"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bill_row_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/bill_row_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bill_row_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/bill_row_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bill_row_amount"
            style="@style/Money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
