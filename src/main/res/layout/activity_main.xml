<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                android:text="Budget"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Your money -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bank balance now"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/balance"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:hint="0.00"
                        android:inputType="numberDecimal|numberSigned"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weekly income"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/weekly_income"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Payday"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/payday"
                        android:layout_width="140dp"
                        android:layout_height="48dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bills -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Bills" />

                    <TextView
                        android:id="@+id/bills_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bill_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:divider="@drawable/divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/bill_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Bill"
                        android:inputType="textCapWords" />

                    <EditText
                        android:id="@+id/bill_day"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:hint="Day"
                        android:inputType="number"
                        android:maxLength="2" />

                    <EditText
                        android:id="@+id/bill_amount"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:hint="Amount"
                        android:inputType="numberDecimal" />

                    <Button
                        android:id="@+id/add_button"
                        style="@style/GreenButton"
                        android:layout_marginStart="4dp"
                        android:text="Add" />
                </LinearLayout>
            </LinearLayout>

            <!-- Paydays -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Each payday" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Tap a payday to change that paycheck"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/forecast_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>

            <!-- End of month -->
            <LinearLayout
                android:id="@+id/end_card"
                style="@style/Card"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/end_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/end_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/update_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/update_button"
            style="@style/GreenButton"
            android:text="Update now"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
