<?xml version="1.0" encoding="utf-8"?>
<!-- Four pages (only one visible at a time) above a bottom tab bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== Summary ========== -->
        <ScrollView
            android:id="@+id/page_summary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PageTitle"
                    android:text="Budget" />

                <LinearLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/hero_green"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/hero_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#D9FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hero_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hero_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Safe to spend: the lowest the balance gets this month -->
                <LinearLayout style="@style/Card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe to spend now"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/safe_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/safe_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Label"
                            android:text="Bank balance now" />

                        <LinearLayout style="@style/MoneyBox">

                            <TextView style="@style/DollarSign" />

                            <EditText
                                android:id="@+id/balance"
                                style="@style/MoneyInput"
                                android:inputType="numberDecimal|numberSigned" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- At a glance: each row jumps to the matching tab -->
                <LinearLayout
                    style="@style/Card"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:id="@+id/glance_payday_row"
                        style="@style/GlanceRow">

                        <TextView
                            style="@style/Label"
                            android:text="Next payday" />

                        <TextView
                            android:id="@+id/glance_payday"
                            style="@style/GlanceValue" />

                        <TextView style="@style/Chevron" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:id="@+id/glance_bill_row"
                        style="@style/GlanceRow">

                        <TextView
                            style="@style/Label"
                            android:text="Next bill" />

                        <TextView
                            android:id="@+id/glance_bill"
                            style="@style/GlanceValue" />

                        <TextView style="@style/Chevron" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:id="@+id/glance_due_row"
                        style="@style/GlanceRow">

                        <TextView
                            style="@style/Label"
                            android:text="Still to pay" />

                        <TextView
                            android:id="@+id/glance_due"
                            style="@style/GlanceValue" />

                        <TextView style="@style/Chevron" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/update_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/update_button"
                        style="@style/GreenButton"
                        android:text="Update now"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== Paydays ========== -->
        <ScrollView
            android:id="@+id/page_paydays"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PageTitle"
                    android:text="Paydays" />

                <LinearLayout style="@style/Card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Tap a payday to change that paycheck"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/forecast_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider"
                        android:orientation="vertical"
                        android:showDividers="middle" />

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp">

                        <TextView
                            android:id="@+id/end_label"
                            style="@style/Label"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/end_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== Bills ========== -->
        <ScrollView
            android:id="@+id/page_bills"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PageTitle"
                    android:text="Bills" />

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginBottom="8dp"
                        android:text="Add a bill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/bill_name"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="Name"
                            android:inputType="textCapWords" />

                        <LinearLayout
                            style="@style/MoneyBox"
                            android:layout_width="120dp"
                            android:layout_marginStart="8dp">

                            <TextView style="@style/DollarSign" />

                            <EditText
                                android:id="@+id/bill_amount"
                                style="@style/MoneyInput"
                                android:inputType="numberDecimal" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/input_bg">

                            <Spinner
                                android:id="@+id/bill_freq"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>

                        <!-- Tapping opens a calendar to pick the next due date -->
                        <TextView
                            android:id="@+id/bill_date"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:hint="Next due date"
                            android:singleLine="true" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/add_button"
                        style="@style/GreenButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:text="Add bill" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Your bills" />

                        <TextView
                            android:id="@+id/bills_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bills_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No bills yet. Add one above."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/bill_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:divider="@drawable/divider"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== Income ========== -->
        <ScrollView
            android:id="@+id/page_income"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PageTitle"
                    android:text="Income" />

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Label"
                            android:text="Weekly income" />

                        <LinearLayout style="@style/MoneyBox">

                            <TextView style="@style/DollarSign" />

                            <EditText
                                android:id="@+id/weekly_income"
                                style="@style/MoneyInput"
                                android:inputType="numberDecimal" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Label"
                            android:text="Payday" />

                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="44dp"
                            android:background="@drawable/input_bg">

                            <Spinner
                                android:id="@+id/payday"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="You get paid this amount every week on this day. To change a single paycheck, tap it on the Paydays tab."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom tab bar (buttons are added in code) -->
    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
