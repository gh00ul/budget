<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                android:text="Budget"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Summary: end-of-month balance (green, or red if it goes negative) -->
            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/hero_green"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/hero_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/hero_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Your money -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="Bank balance" />

                    <LinearLayout style="@style/MoneyBox">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <EditText
                            android:id="@+id/balance"
                            style="@style/MoneyInput"
                            android:inputType="numberDecimal|numberSigned" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="Weekly income" />

                    <LinearLayout style="@style/MoneyBox">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <EditText
                            android:id="@+id/weekly_income"
                            style="@style/MoneyInput"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="Payday" />

                    <FrameLayout
                        android:layout_width="150dp"
                        android:layout_height="44dp"
                        android:background="@drawable/input_bg">

                        <Spinner
                            android:id="@+id/payday"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Bills: tap the header to show or hide the list -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/bills_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Bills" />

                    <TextView
                        android:id="@+id/bills_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/bills_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bills_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/bills_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/bill_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:divider="@drawable/divider"
                        android:orientation="vertical"
                        android:showDividers="middle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/bill_name"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="Bill"
                            android:inputType="textCapWords" />

                        <EditText
                            android:id="@+id/bill_day"
                            style="@style/Input"
                            android:layout_width="56dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:hint="Day"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingHorizontal="4dp" />

                        <EditText
                            android:id="@+id/bill_amount"
                            style="@style/Input"
                            android:layout_width="84dp"
                            android:layout_marginStart="6dp"
                            android:hint="$"
                            android:inputType="numberDecimal" />

                        <Button
                            android:id="@+id/add_button"
                            style="@style/GreenButton"
                            android:layout_marginStart="6dp"
                            android:minWidth="60dp"
                            android:text="Add" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Paydays -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Each payday" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Tap a payday to change that paycheck"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/forecast_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/update_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/update_button"
            style="@style/GreenButton"
            android:text="Update now"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
