<?xml version="1.0" encoding="utf-8"?>
<!-- Three pages (only one visible at a time) above a bottom tab bar. -->
<!-- TooManyViews: single-activity app by design; the three tabs live in this one layout and only one
     page is visible at a time (the others are GONE), so the drawn view count stays well under the limit.
     TooDeepLayout: the label/value rows that stack with large text (tag stack_when_large_text) add one level, so
     the deepest text is 11 levels down; this layout is inflated once per screen, so the cost is a one-off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="TooManyViews,TooDeepLayout">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== Summary ========== -->
        <ScrollView
            android:id="@+id/page_summary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Extra room at the bottom so the message bar never covers the last card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="88dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/PageTitle"
                            android:accessibilityHeading="true"
                            android:text="Budget" />

                        <TextView
                            android:id="@+id/today_label"
                            style="@style/PageSubtitle" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tab_settings"
                        android:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Only shown when a newer version is on GitHub -->
                <LinearLayout
                    android:id="@+id/update_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/update_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/update_button"
                        style="@style/GreenButton"
                        android:text="Update" />
                </LinearLayout>

                <!-- First run: shown until pay and bank balance are set -->
                <LinearLayout
                    android:id="@+id/setup_card"
                    style="@style/Card"
                    android:visibility="gone">

                    <TextView
                        style="@style/SectionTitle"
                        android:accessibilityHeading="true"
                        android:text="Let's work out your Safe to spend"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="6dp"
                        android:text="Three quick things. About a minute."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/setup_pay_row"
                        style="@style/GlanceRow">

                        <!-- Row icons and chevrons are decorative: the tappable row is read as a whole from its
                             label and value text (a filled-in value vs. a prompt like "Not set" tells a screen
                             reader whether a step is done, which the icon shows by turning into a check mark).
                             RowIcon/ChevronIcon already set importantForAccessibility="no"; it's repeated
                             inline because lint doesn't resolve styles. -->
                        <ImageView
                            android:id="@+id/setup_pay_icon"
                            style="@style/RowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tab_paydays" />

                        <!-- Label and value share their own row so that with large text (1.3× and up) MainActivity
                             can put the value on its own line under the label (tag "stack_when_large_text"); side by
                             side, a two-line label left the value so little room that amounts broke mid-number. At
                             normal sizes this lays out exactly like label and value placed straight in the GlanceRow.
                             The 4dp vertical padding changes nothing until the text is taller than 48dp (large text
                             only: the value is at most two lines); then it keeps the text off the dividers. Same for
                             every label + value row below. -->
                        <LinearLayout
                            android:id="@+id/setup_pay_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:tag="stack_when_large_text">

                            <TextView
                                style="@style/GlanceLabel"
                                android:text="Your weekly pay" />

                            <TextView
                                android:id="@+id/setup_pay_value"
                                style="@style/GlanceValue" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ChevronIcon"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <View
                        style="@style/Divider"
                        android:layout_marginStart="52dp" />

                    <LinearLayout
                        android:id="@+id/setup_bills_row"
                        style="@style/GlanceRow">

                        <ImageView
                            android:id="@+id/setup_bills_icon"
                            style="@style/RowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tab_bills" />

                        <LinearLayout
                            android:id="@+id/setup_bills_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:tag="stack_when_large_text">

                            <TextView
                                style="@style/GlanceLabel"
                                android:text="Your regular bills" />

                            <TextView
                                android:id="@+id/setup_bills_value"
                                style="@style/GlanceValue" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ChevronIcon"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <View
                        style="@style/Divider"
                        android:layout_marginStart="52dp" />

                    <LinearLayout
                        android:id="@+id/setup_balance_row"
                        style="@style/GlanceRow">

                        <ImageView
                            android:id="@+id/setup_balance_icon"
                            style="@style/RowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_wallet" />

                        <LinearLayout
                            android:id="@+id/setup_balance_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:tag="stack_when_large_text">

                            <TextView
                                style="@style/GlanceLabel"
                                android:text="Your bank balance" />

                            <TextView
                                android:id="@+id/setup_balance_value"
                                style="@style/GlanceValue" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ChevronIcon"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/setup_next"
                        style="@style/GreenButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/setup_no_bills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:text="I have no regular bills"
                        android:textColor="@color/chip_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Everything else on Summary (hidden during setup) -->
                <LinearLayout
                    android:id="@+id/summary_main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Safe to spend. Tap for the breakdown. -->
                    <LinearLayout
                        android:id="@+id/hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/hero_green"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="20dp">

                        <!-- UseCompoundDrawables: the info icon is drawn at 20dp (its vector is 24dp) and tinted
                             #CC white while the label is #D9 white; a compound drawable would use the vector's
                             intrinsic size and the text's layout, changing the look. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            tools:ignore="UseCompoundDrawables">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Safe to spend this week"
                                android:textColor="#D9FFFFFF"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info"
                                android:tint="#CCFFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/hero_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:letterSpacing="-0.02"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_note"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E6FFFFFF"
                            android:textSize="14sp" />

                        <!-- How much of this week's money is already spent -->
                        <ProgressBar
                            android:id="@+id/hero_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="12dp"
                            android:importantForAccessibility="no"
                            android:indeterminate="false"
                            android:max="1000"
                            android:progressDrawable="@drawable/hero_progress" />

                        <TextView
                            android:id="@+id/hero_breakdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="2"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Bank balance: tap to change; or log a purchase -->
                    <LinearLayout
                        style="@style/Card"
                        android:paddingVertical="4dp">

                        <LinearLayout
                            android:id="@+id/balance_row"
                            style="@style/GlanceRow"
                            android:minHeight="64dp">

                            <ImageView
                                style="@style/RowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_wallet" />

                            <!-- "Bank balance" + status, and the amount: with large text the amount goes on its own
                                 line under the status (tag "stack_when_large_text"), so neither "balance" nor the
                                 amount breaks mid-word. Laid out exactly as before at normal sizes. No vertical
                                 padding here: a long status already wraps to 3+ lines at normal size, and padding
                                 would make that row taller.
                                 NestedWeights: the text column fills what the amount leaves inside this wrapper,
                                 which fills the row between the two icons. With baselineAligned="false" here and on
                                 the row (GlanceRow), a 0dp weighted child of an exact-width parent is measured once,
                                 so the nesting costs no extra measure pass. -->
                            <LinearLayout
                                android:id="@+id/balance_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:tag="stack_when_large_text"
                                tools:ignore="NestedWeights">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Bank balance"
                                        android:textColor="@color/text"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:id="@+id/balance_updated"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/balance_value"
                                    style="@style/Money"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:textColor="@color/text"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/balance_edit_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="8dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_edit"
                                android:tint="@color/hint" />
                        </LinearLayout>

                        <View
                            style="@style/Divider"
                            android:layout_marginStart="52dp" />

                        <TextView
                            android:id="@+id/log_purchase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:drawableStart="@drawable/ic_add"
                            android:drawablePadding="22dp"
                            android:drawableTint="@color/chip_text"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:text="Log a purchase"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- At a glance -->
                    <LinearLayout
                        style="@style/Card"
                        android:paddingVertical="4dp">

                        <LinearLayout
                            android:id="@+id/glance_payday_row"
                            style="@style/GlanceRow">

                            <ImageView
                                style="@style/RowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tab_paydays" />

                            <!-- Label + value stack with large text, like the setup rows. -->
                            <LinearLayout
                                android:id="@+id/glance_payday_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp"
                                android:tag="stack_when_large_text">

                                <TextView
                                    style="@style/GlanceLabel"
                                    android:text="Next payday" />

                                <TextView
                                    android:id="@+id/glance_payday"
                                    style="@style/GlanceValue" />
                            </LinearLayout>

                            <ImageView
                                style="@style/ChevronIcon"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View
                            style="@style/Divider"
                            android:layout_marginStart="52dp" />

                        <LinearLayout
                            android:id="@+id/glance_bill_row"
                            style="@style/GlanceRow">

                            <ImageView
                                style="@style/RowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_bell" />

                            <LinearLayout
                                android:id="@+id/glance_bill_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp"
                                android:tag="stack_when_large_text">

                                <TextView
                                    style="@style/GlanceLabel"
                                    android:text="Next bill" />

                                <TextView
                                    android:id="@+id/glance_bill"
                                    style="@style/GlanceValue" />
                            </LinearLayout>

                            <ImageView
                                style="@style/ChevronIcon"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View
                            style="@style/Divider"
                            android:layout_marginStart="52dp" />

                        <LinearLayout
                            android:id="@+id/glance_due_row"
                            style="@style/GlanceRow">

                            <ImageView
                                style="@style/RowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tab_bills" />

                            <LinearLayout
                                android:id="@+id/glance_due_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:baselineAligned="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp"
                                android:tag="stack_when_large_text">

                                <TextView
                                    style="@style/GlanceLabel"
                                    android:text="Due before payday" />

                                <TextView
                                    android:id="@+id/glance_due"
                                    style="@style/GlanceValue" />
                            </LinearLayout>

                            <ImageView
                                style="@style/ChevronIcon"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- End of month and Extra savings. Both tiles fill the row's height (match_parent in a
                         wrap_content row: LinearLayout measures them, then gives both the taller height), so they
                         stay level when a label or caption wraps to more lines. baselineAligned="false" changes
                         nothing visually: the tiles are vertical LinearLayouts, which report no baseline. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/Tile"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:screenReaderFocusable="true">

                            <TextView
                                android:id="@+id/hero_end_label"
                                style="@style/TileLabel" />

                            <TextView
                                android:id="@+id/hero_end"
                                style="@style/TileValue" />

                            <TextView
                                style="@style/TileCaption"
                                android:text="if you spend your weekly money" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Tile"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:screenReaderFocusable="true">

                            <TextView
                                style="@style/TileLabel"
                                android:text="Extra savings" />

                            <TextView
                                android:id="@+id/hero_cushion"
                                style="@style/TileValue" />

                            <TextView
                                android:id="@+id/hero_cushion_caption"
                                style="@style/TileCaption"
                                android:text="not needed for bills" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== Paydays ========== -->
        <ScrollView
            android:id="@+id/page_paydays"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PageTitle"
                    android:layout_marginTop="8dp"
                    android:accessibilityHeading="true"
                    android:text="Paydays" />

                <TextView
                    android:id="@+id/paydays_subtitle"
                    style="@style/PageSubtitle" />

                <!-- Your usual pay -->
                <LinearLayout
                    android:id="@+id/pay_card"
                    style="@style/Card"
                    android:paddingVertical="4dp">

                    <LinearLayout
                        android:id="@+id/pay_row"
                        style="@style/GlanceRow">

                        <ImageView
                            style="@style/RowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tab_paydays" />

                        <!-- Label + value stack with large text, like the Summary rows. -->
                        <LinearLayout
                            android:id="@+id/pay_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:tag="stack_when_large_text">

                            <TextView
                                style="@style/GlanceLabel"
                                android:text="Your pay" />

                            <TextView
                                android:id="@+id/pay_value"
                                style="@style/GlanceValue" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ChevronIcon"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Shown until pay and bank balance are set -->
                <LinearLayout
                    android:id="@+id/paydays_empty"
                    style="@style/Card"
                    android:gravity="center_horizontal"
                    android:paddingVertical="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your paydays will show here"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/paydays_empty_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/paydays_empty_button"
                        style="@style/GreenButton"
                        android:layout_marginTop="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paydays_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Card"
                        android:paddingTop="12dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Left in the bank after bills, before spending · tap a row for details"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Rows are added in code, including the end-of-month row -->
                        <LinearLayout
                            android:id="@+id/forecast_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/divider_payday"
                            android:orientation="vertical"
                            android:showDividers="middle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chart_card"
                        style="@style/Card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bank balance after each payday's bills"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.gh00ul.budget.BalanceChart
                            android:id="@+id/chart"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== Bills ========== -->
        <ScrollView
            android:id="@+id/page_bills"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="96dp">

                <TextView
                    style="@style/PageTitle"
                    android:layout_marginTop="8dp"
                    android:accessibilityHeading="true"
                    android:text="Bills" />

                <TextView
                    android:id="@+id/bills_subtitle"
                    style="@style/PageSubtitle" />

                <!-- Rows run edge to edge so the swipe layers fill the card -->
                <LinearLayout
                    android:id="@+id/bills_card"
                    style="@style/Card"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="6dp">

                    <!-- Section headers and rows are added in code -->
                    <LinearLayout
                        android:id="@+id/bill_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/bills_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="28dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tab_bills"
                            android:tint="@color/hint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Add your regular bills"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Rent, phone, insurance, subscriptions. Safe to spend keeps money aside so each one is paid on time."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/add_first_bill"
                            style="@style/GreenButton"
                            android:layout_marginTop="14dp"
                            android:text="Add a bill" />

                        <TextView
                            android:id="@+id/bills_none_link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:paddingHorizontal="12dp"
                            android:text="I have no regular bills"
                            android:textColor="@color/chip_text"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/bills_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tap to edit · swipe right when paid · swipe left to delete"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Message bar with Undo (left of the + button on the Bills tab). The message has no line limit: the
             end of it (often the new balance) used to be cut off silently with large text. The bar grows upward
             from the bottom of the pages, beside the + button, never under the status bar or tab bar. -->
        <LinearLayout
            android:id="@+id/undo_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="84dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/snackbar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/undo_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="8dp"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/undo_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="Undo"
                android:textColor="#81C784"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Add bill (Bills tab, once there's at least one bill) -->
        <ImageButton
            android:id="@+id/fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/fab"
            android:contentDescription="Add bill"
            android:elevation="6dp"
            android:src="@drawable/ic_add"
            android:tint="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom tab bar (buttons are added in code) -->
    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
