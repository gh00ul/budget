<?xml version="1.0" encoding="utf-8"?>
<!-- Small peach pill for a secondary action (Export). The pill is 36dp tall inside a 48dp touch area, and the ripple
     stays inside the pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33A04A22">
    <item
        android:bottom="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
