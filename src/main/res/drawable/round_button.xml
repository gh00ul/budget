<?xml version="1.0" encoding="utf-8"?>
<!-- Round card-colored button with a faint rim (Settings, at the top of Summary). The circle is 44dp inside the 48dp
     touch area, and the ripple stays inside it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26A04A22">
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/card_rim" />
        </shape>
    </item>
</ripple>
