<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget's card: sand at the top to peach at the bottom with a light rim, to sit with the owner's
     clock and music widgets. The same in dark mode (no drawable-night copy): it follows the wallpaper, not the theme.
     Android 12+ launchers round it to their own corner size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_card_bottom"
        android:startColor="@color/widget_card_top" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_rim" />
    <corners android:radius="28dp" />
</shape>
