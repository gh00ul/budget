<?xml version="1.0" encoding="utf-8"?>
<!-- Deep terracotta top of the date picker, rounded to match the dialog. Used in light and dark mode. Dark enough for
     the header's unselected line (year or date), which is 70% white: 5.64:1 here (WCAG AA needs 4.5:1). The selected
     line is full white: 9.7:1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#6E3418" />
    <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
</shape>
