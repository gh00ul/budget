<?xml version="1.0" encoding="utf-8"?>
<!-- The Safe to spend card: sand at the top to peach at the bottom with a light rim, like the home-screen widget
     (cocoa in dark mode, from values-night/colors.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/hero_bottom"
        android:startColor="@color/hero_top" />
    <stroke
        android:width="1dp"
        android:color="@color/hero_rim" />
    <corners android:radius="26dp" />
</shape>
