<?xml version="1.0" encoding="utf-8"?>
<!-- The + button on the Bills tab: the same peach as the main button. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33A04A22">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/button_bottom"
                android:startColor="@color/button_top" />
            <stroke
                android:width="1dp"
                android:color="@color/button_rim" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
